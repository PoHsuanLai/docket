# readerd's systemd user unit: the quarantined reader, a separate process that sees
# untrusted text and has no tools. It resolves handles through intentd and asks inferd for its
# model; nothing else. It is the tightest unit of the four: what it reads can be hostile.
[Unit]
Description=Quire quarantined reader (org.quire.Reader1)
After=intentd.service
Wants=intentd.service

[Service]
Type=dbus
BusName=org.quire.Reader1
ExecStart=/usr/libexec/quire/readerd

# --- Sandbox ---
# Only Unix sockets, and no IP address at all, in any namespace.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
IPAddressDeny=any
# No files, no home, no other processes' view: a hijacked reader has nothing to read or write.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
# No setuid gain, no writable-and-executable memory (no JIT, no injected code).
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
# No kernel, module or debug surfaces.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# A narrow syscall set: the system-service baseline, minus privileged and obsolete calls.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete
SystemCallArchitectures=native
# No capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=default.target
