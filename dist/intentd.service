# intentd's systemd user unit: the router, the one decision point for every action the person's
# terminal, the companion, an MCP client or computer use takes. It talks D-Bus to apps, sill,
# inferd, readerd and memoryd, watches logind on the system bus for the end of the person's
# session (the terminal's "allow until logout" grants end with it), and writes one file (the
# person's standing consent). Each sandbox line says what it protects.
#
# Install: the binary at /usr/libexec/quire/intentd, this unit in /usr/lib/systemd/user/, the
# activation file dist/dbus/org.quire.Intents1.service in /usr/share/dbus-1/services/, and the
# default configuration dist/intentd.toml at /etc/xdg/quire/intentd.toml (a file of the
# person's own at ~/.config/quire/intentd.toml replaces it whole).
# scripts/install.sh does all of this, and the sandbox drop-in intentd.service.d/sandbox.conf beside it.
[Unit]
Description=Quire action router (org.quire.Intents1)
# It lives and dies with the graphical session, so what it holds in memory (the terminal's
# standing grants, the undo journal, the breaker) never outlives the person's login.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.quire.Intents1
ExecStart=/usr/libexec/quire/intentd
# No loader variables from the session reach the daemon: porter gives its fixed caller role only
# to a unit that unsets them (applied after the manager environment and Environment=).
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE

# --- Sandbox ---
# Only Unix sockets (the session bus, inferd's and memoryd's sockets). The rest of the sandbox (no
# network at all, a read-only system, no home folder, private temporary files, no devices and no
# kernel surfaces) is intentd.service.d/sandbox.conf, which the installer leaves out on a system
# that refuses private namespaces for user units.
RestrictAddressFamilies=AF_UNIX
# The consent file's directory is made before the sandbox is set up (`+`: outside it), because a
# read-write path that does not exist stops the unit; the path itself is in the drop-in.
ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/quire/intents
# No setuid gain, no writable-and-executable memory (no JIT, no injected code).
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# A narrow syscall set: the system-service baseline, minus privileged and obsolete calls.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @obsolete
SystemCallArchitectures=native
# No capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=default.target
