#compdef quire-do
# zsh completion for quire-do. What to offer is quire-do's own answer (`quire-do __complete`),
# so apps, actions, parameter flags and choices follow the installed manifests.
_quire_do() {
  local -a candidates
  candidates=("${(@f)$(quire-do __complete "${(@)words[2,CURRENT]}" 2>/dev/null)}")
  compadd -a candidates
}
_quire_do "$@"
